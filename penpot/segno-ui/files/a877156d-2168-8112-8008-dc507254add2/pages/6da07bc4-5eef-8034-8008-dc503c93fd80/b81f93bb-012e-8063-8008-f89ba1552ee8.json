                "fontFamily": "Arimo",
                "text": "c\/ Interface switches (#1646, frames 18-24; shipped in PRs #1649-#1655)"
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
