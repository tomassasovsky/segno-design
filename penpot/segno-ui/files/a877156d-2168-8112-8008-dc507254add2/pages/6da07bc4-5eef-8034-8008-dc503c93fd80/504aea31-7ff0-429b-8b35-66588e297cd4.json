                ],
                "fontFamily": "Arimo",
                "text": "Settings \u2192 Audio routing keeps four tasks: Input setup, Recording inputs, Output routing and Output setup. Larger interfaces scroll at the same control size. Names use the shared fixed bottom keyboard; Save confirms storage first, while Cancel preserves the name. Reconnecting the interface ends an old edit."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "28",
            "fontWeight": "400",
            "type": "paragraph",
            "fontVariantId": "normal-400",
            "textDecoration": "none",
            "letterSpacing": "0",
