                "fontVariantId": "normal-400",
                "textDecoration": "none",
                "letterSpacing": "0",
                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "Stereo source edits and whole-track destinations apply together. Missing ports retain removable routing intent; unavailable ports cannot be newly selected. Existing audio and lane identities stay intact. Recording locks explain a refused change."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
