                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "Scope: Backing & click currently controls click; backing routing remains in the media slice. Settings is the console tray. Shared mix-save recovery is specified below. Appliance port and physical-control checks remain separate."
              }
            ],
