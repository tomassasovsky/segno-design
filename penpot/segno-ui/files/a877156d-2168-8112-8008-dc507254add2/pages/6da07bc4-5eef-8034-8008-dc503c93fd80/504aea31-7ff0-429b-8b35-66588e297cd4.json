            "letterSpacing": "0",
            "fills": [
              {
                "fillColor": "#a3adbd",
                "fillOpacity": 1
              }
            ],
            "fontFamily": "Arimo"
          },
          {
            "lineHeight": "1.4",
            "fontStyle": "normal",
            "children": [
              {
                "lineHeight": "1.4",
                "fontStyle": "normal",
                "textTransform": "none",
                "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
                "fontSize": "28",
