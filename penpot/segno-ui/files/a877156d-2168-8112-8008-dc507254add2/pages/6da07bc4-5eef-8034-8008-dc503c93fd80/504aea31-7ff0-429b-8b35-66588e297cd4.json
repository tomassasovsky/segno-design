                "fillOpacity": 1
              }
            ],
            "fontFamily": "Arimo"
          },
          {
            "lineHeight": "1.4",
            "fontStyle": "normal",
            "children": [
              {
                "lineHeight": "1.4",
                "fontStyle": "normal",
                "textTransform": "none",
                "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
                "fontSize": "28",
                "fontWeight": "400",
                "fontVariantId": "normal-400",
                "textDecoration": "none",
                "letterSpacing": "0",
                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "Touch and encoder use the same choices. Slider edits belong to one channel; changing channel or cancelling discards the draft. Double-tap resets trim and level to 0 dB, pan and balance to centre, without an intermediate value. Mono keeps its saved balance while disabling the control."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "28",
            "fontWeight": "400",
            "type": "paragraph",
