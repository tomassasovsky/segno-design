                "fontVariantId": "normal-400",
                "textDecoration": "none",
                "letterSpacing": "0",
                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "The Tuner's one-time seed on pedal 2 (#1229, D11) is removed: the default map carries Hold \u00b7 Tuner there."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
