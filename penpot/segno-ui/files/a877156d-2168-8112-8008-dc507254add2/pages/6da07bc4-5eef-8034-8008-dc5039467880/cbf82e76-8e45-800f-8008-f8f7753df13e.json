            "textDecoration": "none",
            "letterSpacing": "0",
            "fills": [
              {
                "fillColor": "#a3adbd",
                "fillOpacity": 1
              }
            ],
            "fontFamily": "Arimo"
          },
          {
            "lineHeight": "1.4",
            "fontStyle": "normal",
            "children": [
              {
                "lineHeight": "1.4",
