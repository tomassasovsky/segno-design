                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "A recording that did not come out whole, or that dropped frames, still opens the sheet: that is where the player reads what is wrong with it."
              }
