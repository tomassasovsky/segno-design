                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "When opening a session or starting a new loop ends a running performance recording, the recording is saved and the completion sheet (04 \/ Saved recording) does not open over the new session. The stage shows a notice instead, titled \"Recording saved\", with \"Find it in Library > Audio.\" under it. The session's own notice arrives at about the same time, and this one is kept beside it so it is not replaced unread."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "24",
            "fontWeight": "400",
            "textDirection": "ltr",
            "type": "paragraph",
            "fontVariantId": "normal-400",
            "textDecoration": "none",
            "letterSpacing": "0",
            "fills": [
              {
                "fillColor": "#a3adbd",
                "fillOpacity": 1
              }
            ],
            "fontFamily": "Arimo"
          },
          {
            "lineHeight": "1.4",
            "fontStyle": "normal",
            "children": [
              {
                "lineHeight": "1.4",
                "fontStyle": "normal",
                "textTransform": "none",
