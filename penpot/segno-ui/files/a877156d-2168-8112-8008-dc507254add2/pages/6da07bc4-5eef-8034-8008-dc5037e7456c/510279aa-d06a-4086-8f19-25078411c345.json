                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": ""
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "28",
            "fontWeight": "400",
            "type": "paragraph",
            "fontVariantId": "normal-400",
            "textDecoration": "none",
            "letterSpacing": "0",
            "fills": [
              {
                "fillColor": "#a3adbd",
                "fillOpacity": 1
              }
            ],
            "fontFamily": "Arimo"
          },
          {
            "lineHeight": "1.4",
            "fontStyle": "normal",
            "children": [
              {
                "lineHeight": "1.4",
                "fontStyle": "normal",
                "textTransform": "none",
                "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
                "fontSize": "28",
                "fontWeight": "400",
                "fontVariantId": "normal-400",
                "textDecoration": "none",
                "letterSpacing": "0",
                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "Why: on build .195 both inputs' chains were saved off; the page read as on, the only way back was the foot FX mode, and racks arriving with every pedal off compounded the silence."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "28",
