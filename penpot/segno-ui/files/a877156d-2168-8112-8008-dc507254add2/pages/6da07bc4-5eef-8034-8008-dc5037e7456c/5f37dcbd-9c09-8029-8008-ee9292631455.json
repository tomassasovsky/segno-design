                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "Built-in pedal faces print the effect's own name: Drive, FILTER, OCTAVER (Delay, Tremolo, Echo, Reverb already matched). Rack modules keep their faces (Overdrive, LPF, OCTAVES). Faces stay English in every locale."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
