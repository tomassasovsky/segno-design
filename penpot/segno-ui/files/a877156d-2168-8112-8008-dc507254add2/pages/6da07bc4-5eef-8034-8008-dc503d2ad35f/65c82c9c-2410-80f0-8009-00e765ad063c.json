                ],
                "fontFamily": "Arimo",
                "text": "The Tracks view's track meter fills with a vertical gradient, after the Looper X's level meter (measured from frames the #891 rig rendered, session s22meter): #42E700 at the top of the fill to #217500 at its foot, half the top's brightness in each channel."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
