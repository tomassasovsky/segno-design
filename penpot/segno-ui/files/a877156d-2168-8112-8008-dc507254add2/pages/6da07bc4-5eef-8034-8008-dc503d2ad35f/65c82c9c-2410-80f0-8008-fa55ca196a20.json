                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "The meter shows what a track captures, not only what it plays (decision D1; D2 as revised by #1955)."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "28",
            "fontWeight": "400",
