            "lineHeight": "1.4",
            "fontStyle": "normal",
            "children": [
              {
                "lineHeight": "1.4",
                "fontStyle": "normal",
                "textTransform": "none",
                "textAlign": "left",
                "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
                "fontSize": "28",
                "fontWeight": "400",
                "textDirection": "ltr",
                "fontVariantId": "normal-400",
                "textDecoration": "none",
                "letterSpacing": "0",
                "fills": [
                  {
                    "fillColor": "#a3adbd",
                    "fillOpacity": 1
                  }
                ],
                "fontFamily": "Arimo",
                "text": "- An overdubbing track meters the louder of its loop's playback and its input, in its state colour: the overdub plays the loop while it adds the layer, so the meter shows both (#1955, replacing D2's input only). Its waveform draws each bucket as the overdub writes it, the loop and the new layer together, on the pass it records."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
