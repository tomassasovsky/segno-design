              {
                "lineHeight": "1.2",
                "fontStyle": "normal",
                "textTransform": "none",
                "textAlign": "left",
                "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
                "fontSize": "24",
