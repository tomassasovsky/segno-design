                  }
                ],
                "fontFamily": "Arimo",
                "text": "The Clear custom assignments dialog has a second action, Use default assignments. It replaces the draft's Custom map, both banks, with the map a console starts with (page 10, 02 \/ Performance \/ Custom and its c\/ note). It sits in the dialog and not in the titlebar because the titlebar row has no room for a fourth wide button when Restore assignments shows."
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
            "fontSize": "24",
            "fontWeight": "400",
            "textDirection": "ltr",
            "type": "paragraph",
            "fontVariantId": "normal-400",
            "textDecoration": "none",
            "letterSpacing": "0",
            "fills": [
              {
                "fillColor": "#a3adbd",
                "fillOpacity": 1
              }
            ],
            "fontFamily": "Arimo"
          },
