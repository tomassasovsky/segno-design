                "fontFamily": "Arimo",
                "text": "c\/ Native implementation \u00b7 Touch calibration (#1330, branch claude\/ivi-only-1330-p3)"
              }
            ],
            "textTransform": "none",
            "textAlign": "left",
            "fontId": "custom-99a2c890-1804-450c-8af8-6b60ee9a6b27",
