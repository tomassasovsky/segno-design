t":"span","fill":"#6b6b73","content":"→","lineHeight":1.21,"fontFamily":"Inter","fontSize":14,"fontWeight":"normal"},{"type":"text","id":"S6ZwI","name":"recorder","context":"span","fill":"#6b6b73","content":"recorder","lineHeight":1.23,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"text","id":"vBZau","name":"no rack","context":"div","fill":"#6b6b73","content":"no rack","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"500"},{"type":"text","id":"nO5Yh","name":"tap to load one","context":"div","fill":"#9a9aa2","content":"tap to load one","lineHeight":1.35,"fontFamily":"Inter","fontSize":14,"fontWeight":"normal"},{"type":"text","id":"D5tbK","name":"MONITOR: OFF","context":"div","fill":"#6b6b73","content":"MONITOR: OFF","lineHeight":1.23,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal","letterSpacing":0.78}]}]}]},{"type":"frame","id":"e3iGtK","layoutPosition":"absolute","x":0,"y":1046,"name":"button","context":"button","width":"fill_container(1918)","height":31,"padding":[1,6],"justifyContent":"center","alignItems":"center","children":[{"type":"rectangle","cornerRadius":119,"id":"TjOka","name":"span","context":"span","fill":"#3a3a40","width":62,"height":5}]}]}]},{"type":"text","id":"W0tCF","x":0,"y":1176,"name":"t/signal-input","fill":"#ffffff","content":"Signal — input tab","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"P1n0w","x":0,"y":1218,"name":"g/signal-input","fill":"#738cf2","content":"base","fontFamily":"Inter","fontSize":12,"fontWeight":"600"},{"type":"text","id":"jC7Fd","x":0,"y":1257,"name":"c/signal-input","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Printed into the take. MODIFIED badge. An input card always carries its monitor line, rack or no rack — whether you hear yourself is a fact about the jack, not about the chain on it. That is where it parts company with the loop face, whose vacant card omits the line because there is no chain to hear. Loopback sockets are excluded from the run — and a rig whose every socket is loopback gets its own empty message (a running engine with nothing capturable), distinct from no sockets at all, which is a stopped engine. MODIFIED compares the live chain against the rack’s saved copy — entry set, order, per-entry bypass, parameter values; a parameter nudged by a MIDI mapping counts, because drift is drift whoever’s finger moved it. The chain’s own power is not part of the comparison: on/off is the card’s switch, not the chain’s content.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"gGDxS","x":4280,"y":260,"name":"03 / signal master","width":1920,"height":1289,"layout":"none","children":[{"type":"text","id":"X56fP","x":0,"y":10,"name":"Screen label / signal master","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"03  signal master","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"H7lAnH","x":0,"y":72,"name":"SIGNAL / signal-master","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"cZAJv","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"NbwdV","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"L6e2I","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"w7r35T","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"DfaC4","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"w9bN5","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strok