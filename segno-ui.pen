6}]}]}]},{"type":"rectangle","cornerRadius":[0,0,17,17],"id":"w9XlQ","x":1,"y":-1078,"name":"div","context":"div","fill":"#161618","width":1918,"height":1078,"stroke":"#3a3a40","strokeWidth":{"bottom":1},"strokeAlignment":"inner","effect":{"type":"shadow","shadowType":"outer","color":"#00000099","offset":{"x":0,"y":19},"blur":48}},{"type":"rectangle","cornerRadius":119,"id":"DKZze","x":926.5,"y":11,"name":"button","context":"button","fill":"#ffffff21","width":67,"height":6},{"type":"frame","id":"nMPat","x":1,"y":1,"name":"div","context":"div","width":1918,"height":1078,"fill":"#08080adb","padding":29,"justifyContent":"center","alignItems":"center","children":[{"type":"frame","id":"dzton","name":"div","context":"div","width":552,"layout":"vertical","children":[{"type":"text","id":"WIFAi","name":"Pedal update didn’t finish","context":"h3","fill":"#f3f4f7","textGrowth":"fixed-width","width":"fill_container","content":"Pedal update didn’t finish","lineHeight":1.15,"textAlign":"center","fontFamily":"Inter","fontSize":20,"fontWeight":"650"},{"type":"frame","id":"U9vNh","name":"spacer","width":"fill_container","height":12,"layout":"none"},{"type":"text","id":"L1jkdY","name":"Your pedal still works on its previous f","context":"p","fill":"#9a9aa2","textGrowth":"fixed-width","width":"fill_container","content":"The update stopped partway through, so your pedal’s switches and lights stay off until it is completed. Segno can’t finish it automatically yet — the pedal’s firmware may need to be flashed again from a computer.","lineHeight":1.55,"textAlign":"center","fontFamily":"Inter","fontSize":16,"fontWeight":"normal"},{"type":"frame","id":"qOJ8l","name":"spacer","width":"fill_container","height":19,"layout":"none"},{"type":"frame","id":"QXl2g","width":"fill_container","layout":"vertical","alignItems":"center","children":[{"type":"frame","id":"db9ub","name":"Continue","context":"button","width":91.72,"height":40,"fill":"#16233d","cornerRadius":10,"stroke":"#3b82f6","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","padding":[10,14],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"w588s","fill":"#3b82f6","content":"Continue","lineHeight":1.2,"textAlign":"center","fontFamily":"Inter","fontSize":15,"fontWeight":"normal"}]}]}]}]}]},{"type":"text","id":"F00b4","x":0,"y":1176,"name":"t/firmware-failed-interrupted","fill":"#ffffff","content":"Pedal firmware — failed (interrupted)","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"jSnPH","x":0,"y":1218,"name":"g/firmware-failed-interrupted","fill":"#738cf2","content":"failure","fontFamily":"Inter","fontSize":12,"fontWeight":"600"},{"type":"text","id":"RcgzY","x":0,"y":1257,"name":"c/firmware-failed-interrupted","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"The interrupted class of the failed gate (#690): the flash began writing and did not finish, so the pedal may be parked in its bootloader — its switches and lights stay off. The failure classes are distinguished because the old dialog showed one generic failure for every cause: the not-started reassurance (still on its previous firmware, Segno will retry) is only true when the write never began, and saying it here would be a lie. No promise of automatic recovery either — that was deliberately de-promised until the recovery path (slice 3 of #670) ships. The body is the shipping string from app_en.arb (pedalFirmwareGateFailedInterruptedBody), not the PR draft.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"text","id":"J4zd0","x":120,"y":8674,"name":"H/SESSION & CAPTURE","fill":"#ffffff","content":"SESSION & CAPTURE","fontFamily":"Inter","fontSize":52,"fontWeight":"600"},{"type":"text","id":"x0piT","x":120,"y":8761,"name":"S/SESSION & CAPTURE","fill":"#9ea3b0","content":"saving work, and getting it off the box","fontFamily":"Inter","fontSize":22,"fontWeight":"normal"}]},{"type":"frame","id":"Tl4hO","x":180,"y":31508,"name":"11  Earlier control & capture notes","width":6320,"height":760,"fill":"#1a1d24","cornerRadius":24,"stroke":"#48505f","strokeWidth":2,"layout":"none","children":[{"type":"text","id":"szFQU","x":120,"y":62,"name":"11  Earlier control & capture notes / Section title","fill":"#d5ddf5","content":"11  Earlier control & capture notes","fontFamily":"Arimo","fontSize":68,"fontWeight":"700"},{"type":"text","id":"yDynj","x":120,"y":160,"name":"11  Earlier control & capture notes / Status","fill":"#a3adbd","content":"Retained annotations  ·  0 screens","fontFamily":"Arimo","fontSize":36,"fontWeight":"normal"},{"type":"text","id":"nKocr","x":120,"y":260,"name":"c/pedal-mode-switch","fill":"$text-muted","textGrowth":"fixed-width","width":640,"content":"MODE SWITCH group (shipped #632, written back): the Hold-for-FX toggle governs the pedal's Mode switch only. Off (default) a press cycles Record → Mute → FX and holding arms performance recording. On, a press cycles Record ↔ Mute, holding enters FX at the long-press threshold and a second hold (or a tap) returns to the mode FX was entered from; the hold-to-arm gesture yields, so performance recording stays on the toolbar and keyboard. Keyboard M and the on-screen mode chip always cycle all three modes regardless of the toggle.","fontFamily":"$font-ui","fontSize":14,"fontWeight":"normal"},{"type":"text","id":"J7Bxl7","x":120,"y":402,"name":"c/capture-recover-retired","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Retired and deleted (#735, 2026-08-26): the recovery flow this screen drew was cut — #679's silent recovery removed the boot prompt, and dismissed captures are simply retained ~30 days as recovered files, surfaced by the Library's quiet Recovered group (SESSION & CAPTURE / library-recovered), where Keep promotes a take back under its session. This note stays as the record of why there is no recover dialog.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"},{"type":"text","id":"Y8w8PT","x":120,"y":474,"name":"c/mode-colours","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Mode colours, written back from #693/#714 (owner calls, 2026-08-20): mute reads GREEN on every surface — $success over the $success-surface wash on the chrome pills (stage status bar and desktop ModeIndicator; the DS indicator specimen 'mode pill / mute' records the variant, and the screens keep drawing the nominal REC state), $led-green on the 7″ readout and on the pedal's MODE LED. Rec is red everywhere: the pedal's LED moved rec green → red in the same stroke, because mute could not simply take green while rec held it — that would make the pedal's two BOOT modes (record and mute) indistinguishable on the one indicator whose job is naming them. FX stays blue. The desktop ModeIndicator's REC arm reads $rec #e5484d, the chrome red the pills draw — not $signal-rec #ff1744, the stage record hue. The pedal plate itself is not drawn in this file, so its two calls are recorded here: (1) the MODE LED is SOLID in every state and reports the interaction mode only — the performance-armed BLINK is gone, because armed already shows on both screens (the stage bar's pill and the 7″ readout's REC pill with running elapsed) and a blinking red was only distinguishable from a solid red by watching a full half-period; do not reintroduce it on the next pass at the pedal. (2) the ring's idle sweep is a dim neutral $ring-glow in every mode, never a dimmed mode tint — a dim red idle ring in rec mode reads as a live take from stage distance; red on the ring means recording activity, exclusively.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"},{"type":"text","id":"F352fa","x":120,"y":620,"name":"c/signal-domain-retired","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Retired (#1016 slice 3f, 2026-09-11): the tray's SIGNAL domain is gone, and the rail row in its place opens the accepted Effects page as a ROUTE — the same treatment Loop settings has, because that page takes the whole screen and its editors are direct controls rather than a list that opens a dialog. It keeps the signal-path glyph and the first position for the reason Signal held them: the signal path is what the rest of the console configures. The tray now lands on Control, the first face the rail still has. Two things went with the domain: the lane-cache indicators (the only surface that drew them) and their preference, and the hosted-plugin browser — the accepted Add effects offers the factory catalogue and Single FX, this file draws no plugin entry, and the owner's call (2026-09-11) was to drop the browser rather than invent one. Plugin hosting stays in the engine and the repository, so a chain that still carries a plugin entry keeps working.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]}]},{"type":"frame","id":"adlbY","x":13560,"y":40100,"name":"03   DESIGN SYSTEM","width":6500,"height":11280,"fill":"#111318","cornerRadius":32,"stroke":"#343943","strokeWidth":3,"layout":"none","children":[{"type":"text","id":"sodWd","x":180,"y":64,"name":"03   DESIGN SYSTEM / Title","fill":"#eef0f5","content":"03   DESIGN SYSTEM","fontFamily":"Arimo","fontSize":104,"fontWeight":"700"},{"type":"text","id":"gPyGI","x":180,"y":196,"name":"03   DESIGN SYSTEM / Description","fill":"#a5adba","content":"Foundations, components and reusable hardware","fontFamily":"Arimo","fontSize":42,"fontWeight":"normal"},{"type":"frame","id":"iZJPi","x":90,"y":300,"name":"01  Foundations & components","width":6320,"height":10205,"fill":"#1a1d24","cornerRadius":24,"stroke":"#48505f","strokeWidth":2,"layout":"none","children":[{"type":"text","id":"nQRyu","x":120,"y":62,"name":"01  Foundations & components / Section title","fill":"#d5ddf5","content":"01  Foundations & components","fontFamily":"Arimo","fontSize":68,"fontWeight":"700"},{"type":"text","id":"kjz5T","x":120,"y":160,"name":"01  Foundations & components / Status","fill":"#a3adbd","content":"Design system source and reusable hardware w