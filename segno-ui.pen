nder the name — which is also what keeps the cell at the shared two-line height. A name too long for one line truncates; it never wraps, because the grid’s label is single-line. 746 wide, not 744: four 166px columns need 694, plus 25 padding either side and the 1px border each side. Zero slack — a future padding tweak would silently halve the column count. Mid-scan the count row reads “Looking for plugins…”: a count of zero mid-scan is not a fact about the machine.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"D3oui","x":4280,"y":4535,"name":"12 / rack delete","width":1920,"height":1289,"layout":"none","children":[{"type":"text","id":"xAkgL","x":0,"y":10,"name":"Screen label / rack delete","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"12  rack delete","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"Q10B3","x":0,"y":72,"name":"SIGNAL / rack-delete","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"ZALPi","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"i8p3T","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"p0eCq","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"vuQUu","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"g5674","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"caLWt","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","padding":1,"justifyContent"