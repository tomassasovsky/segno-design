isabling the control.\nStereo source edits and whole-track destinations apply together. Missing ports retain removable routing intent; unavailable ports cannot be newly selected. Existing audio and lane identities stay intact. Recording locks explain a refused change.\nScope: Backing & click currently controls click; backing routing remains in the media slice. Settings is the console tray. Shared mix-save recovery is specified below. Appliance port and physical-control checks remain separate.","lineHeight":1.4,"fontFamily":"Arimo","fontSize":28,"fontWeight":"normal"},{"type":"frame","id":"whoPA","x":4280,"y":7200,"name":"c/ Shared mix recovery · M2.1","width":1840,"layout":"vertical","gap":24,"children":[{"type":"text","id":"AWjLY","name":"Recovery state title","fill":"#d5ddf5","content":"Mix settings recovery","fontFamily":"Arimo","fontSize":36,"fontWeight":"700"},{"id":"D9vom","type":"ref","ref":"v8WR8k","name":"Required recovery · Retry only","width":"fill_container","padding":[24,28],"gap":24,"fill":"#2b3341","stroke":"#475467","descendants":{"VUU1P":{"width":16,"height":16,"fill":"#f06a6a"},"DZO9h":{"content":"Mix settings need recovery\nAudio was stopped to protect your settings.","fontSize":28,"lineHeight":1.4,"fill":"#f2f4f8"},"xQn7V":{"padding":[18,28],"fill":"#374253"},"xQn7V/P8fizX":{"content":"Retry","fontSize":28,"fill":"#f2f4f8"}}},{"type":"text","id":"D8oUQS","name":"Mix recovery behavior","fill":"#a3adbd","textGrowth":"fixed-width","width":"fill_container","content":"A failed mix write keeps the prior active settings. If restoring the prior saved value also fails, stop audio and keep this message visible. Retry restores that saved value; it does not resume audio automatically.\n\nNo dismiss action while recovery is required. Mix edits and session replacement remain unavailable until Retry succeeds. Input setup requires a connected device; a device change during session capture cancels that save.","lineHeight":1.4,"fontFamily":"Arimo","fontSize":28,"fontWeight":"normal"}]}]},{"type":"frame","id":"wHUmy","x":180,"y":42860,"name":"22  Output setup","context":"Proposal: output names, independent output level/balance/mute and stereo/mono. Silent prototype.","width":6320,"height":2804,"fill":"#171c25","cornerRadius":24,"stroke":"#353f51","strokeWidth":2,"layout":"none","children":[{"type":"text","id":"i7ECr","x":120,"y":62,"name":"Output setup / Section title","fill":"#d5ddf5","content":"22  Output setup","fontFamily":"Arimo","fontSize":68,"fontWeight":"700"},{"type":"text","id":"LEC0E","x":120,"y":160,"name":"Output setup / Proposal status","fill":"#a3adbd","content":"Current UX · 6 screens · proposal","fontFamily":"Arimo","fontSize":36,"fontWeight":"normal"},{"type":"frame","id":"J6WLX","x":120,"y":260,"name":"1 / Main output","width":1920,"height":1152,"layout":"none","children":[{"type":"text","id":"H2hbpD","x":0,"y":10,"name":"Main output / Label","fill":"#d5ddf5","content":"Main output","fontFamily":"Arimo","fontSize":36,"fontWeight":"normal"},{"type":"frame","id":"QPEOk","x":0,"y":72,"name":"Output setup / Main output","clip":true,"width":1920,"height":1080,"fill":"#101114","layout":"none","children":[{"type":"frame","id":"g05JT","x":0,"y":0,"name":"topbar","context":"header","metadata":{"type":"prototype-element","tag":"header","rect":{"x":0,"y":0,"width":1920,"height":96},"textAlign":"start"},"width":1920,"height":96,"stroke":"#3d3d3d","strokeWidth":{"bottom":1},"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"QUvcD","x":36,"y":15.5,"name":"Back","context":"Prototype control: back","metadata":{"type":"prototype-element","tag":"button","rect":{"x":36,"y":15.5,"width":64,"height":64},"textAlign":"center"},"width":64,"height":64,"cornerRadius":8,"stroke":"#515d6e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"KOqh7","x":18,"y":18,"name":"ui-icon","context":"svg","metadata":{"type":"prototype-element","tag":"svg","rect":{"x":18,"y":18,"widt