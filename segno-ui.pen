,"fontSize":12,"fontWeight":"600"},{"type":"text","id":"lQW4G","x":0,"y":1257,"name":"c/track-routing","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Each checked input is a lane; opening one shows that lane's own outputs, in the drawer the rest of the console opens rows into (LOOP / loop-output's grid, not the older inline block this screen used to draw). Effects stay on the Signal page. BUILT: the panel is capped to the screen and its two groups scroll, since an eight-input rig with a lane open is taller than 1080. The group captions are sticky — the current one pins overhead and is pushed out by the next, and the one you have NOT reached waits at the bottom edge until its own caption rises into view, so both of the panel's questions are visible from the start. The lane's output readout is set in the mono face, like the same string one screen over on tracks-routing.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"EMdFi","x":2200,"y":1669,"name":"05 / track unrouted","width":1920,"height":1289,"layout":"none","children":[{"type":"text","id":"jbwcH","x":0,"y":10,"name":"Screen label / track unrouted","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"05  track unrouted","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"jzjWX","x":0,"y":72,"name":"TRACKS / track-unrouted","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"ALS27","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"i2xxj7","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"LkM0I","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"ItnOu","n