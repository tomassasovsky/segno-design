":"frame","id":"FOB9N","layoutPosition":"absolute","x":1590,"y":160,"name":"Chain on pill","width":92,"height":33,"fill":"#16233d","cornerRadius":119,"stroke":"#3b82f6","strokeWidth":1,"layout":"vertical","justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"gUxlC","name":"label","fill":"#3b82f6","content":"Chain on","fontFamily":"Inter","fontSize":15,"fontWeight":"normal"}]}]}]},{"type":"frame","id":"WlVLt","layoutPosition":"absolute","x":0,"y":1046,"name":"button","context":"button","width":"fill_container(1918)","height":31,"padding":[1,6],"justifyContent":"center","alignItems":"center","children":[{"type":"rectangle","cornerRadius":119,"id":"N0iKuK","name":"span","context":"span","fill":"#3a3a40","width":62,"height":5}]}]}]},{"type":"text","id":"Xu3Jv","x":0,"y":1176,"name":"t/signal-detail","fill":"#ffffff","content":"Signal — rack detail","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"ZhTwu","x":0,"y":1218,"name":"g/signal-detail","fill":"#738cf2","content":"open","fontFamily":"Inter","fontSize":12,"fontWeight":"600"},{"type":"text","id":"H4NXZs","x":0,"y":1257,"name":"c/signal-detail","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Rack chooser, the chain as chips, the level and whether it is in the mix at all. A boolean inside a stack of segmented rows stays segmented; a boolean in a list row is a switch — which is why the master face’s per-output booleans are switches and “in the mix” is not. “Hear while playing” is input-only: the tri-state exists for auto, which resolves against the record arm, and only a hardware input can be armed — the row is omitted on loop, track and master. The chain caption carries the chain’s own power (“Chain on” / “Chain off”, the consequence sentence in warning beside it while off — without the pill, a chain switched off by a pedal could never be switched back on) and “Re-sync from input”, offered only while the routed input has an audible chain to copy. An overdub taken against a since-edited input chain shows the mismatch note above the chain: it is captured dry and does not re-inherit.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"S4vjX","x":2200,"y":1685,"name":"05 / fx edit","width":1920,"height":1273,"layout":"none","children":[{"type":"text","id":"g8oFAt","x":0,"y":10,"name":"Screen label / fx edit","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"05  fx edit","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"u0MHpD","x":0,"y":72,"name":"SIGNAL / fx-edit","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"wnziH","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"Gd5hB","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"Dq4Ef","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"kkinK","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"YqHqN","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"H9kL6","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","padding":1,"justifyContent":"center","alignItems":"center","children":[{"type":"frame","id":"NeMF8","name":"svg","context":"svg","clip":true,"width":19,"height":19,"layout":"none","children":[{"type":"ellipse","id":"Uwbio","x":8.708333333333332,"y":3.1666666666666665,"width":1.5833333333333333,"height":1.5833333333333333,"stroke":"#9A9AA2","strokeWidth":1.58333333333333