"div","width":"fill_container","height":6,"fill":"#0b0b0c","cornerRadius":999,"layout":"none","children":[{"type":"rectangle","cornerRadius":999,"id":"q7M4Zh","x":0,"y":0,"name":"fill","fill":"#3b82f6","width":640,"height":6}]}]},{"type":"frame","id":"jw6wI","name":"Cancel","context":"button","fill":"#1e1e21","cornerRadius":8,"stroke":"#3a3a40","strokeWidth":1,"strokeAlignment":"inner","padding":[10,14],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"pdh2W","fill":"#f3f4f7","content":"Cancel","textAlign":"center","fontFamily":"Inter","fontSize":15,"fontWeight":"normal"}]}]},{"type":"frame","id":"u7vhF","name":"banner","context":"div","width":"fill_container","fill":"#30a46c24","cornerRadius":11,"stroke":"#30a46c","strokeWidth":1,"strokeAlignment":"inner","gap":12,"padding":[13,15],"alignItems":"center","children":[{"type":"ellipse","id":"wUtNL","name":"dot","fill":"#30a46c","width":9,"height":9},{"type":"frame","id":"NipQo","name":"msgcol","context":"div","width":"fill_container","layout":"vertical","gap":6,"children":[{"type":"text","id":"f9WVp","name":"msg","fill":"#f3f4f7","textGrowth":"fixed-width","width":"fill_container","content":"Restored · de-clip + denoise.  Raw take kept until you save.","fontFamily":"Inter","fontSize":15,"fontWeight":"normal"}]},{"type":"frame","id":"Ll9ZB","name":"Revert to raw take","context":"button","fill":"#1e1e21","cornerRadius":8,"stroke":"#3a3a40","strokeWidth":1,"strokeAlignment":"inner","padding":[10,14],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"V4JLfy","fill":"#f3f4f7","content":"Revert to raw take","textAlign":"center","fontFamily":"Inter","fontSize":15,"fontWeight":"normal"}]}]}]}]},{"type":"frame","id":"fjvoa","layoutPosition":"absolute","x":0,"y":1046,"name":"button","context":"button","width":"fill_container(1918)","height":31,"padding":[1,6],"justifyContent":"center","alignItems":"center","children":[{"type":"rectangle","cornerRadius":119,"id":"Q2TDwO","name":"span","context":"span","fill":"#3a3a40","width":62,"height":5}]}]}]},{"type":"text","id":"bGTtg","x":0,"y":1176,"name":"c/restore-states","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Loop-close restoration, the offline counterpart to conditioning. #697 slice S5, frame 4 of 4. Opt-in is per INPUT (input_restore.N, owner-confirmed), so it lives on the input detail beside conditioning. It is deliberately NOT dressed in the record-red 'printed into the take' language: the chip reads OFFLINE · AT LOOP CLOSE and the palette is neutral, because restoration is reversible and never touches the monitor. Two flags map to LE_RESTORE_DECLIP | LE_RESTORE_DENOISE (De-clip + Denoise · RNNoise). The state list is the lifecycle of le_track_snapshot.restore_state: armed (0, enabled and waiting), Queued (1 — one job in flight engine-wide, the rest wait), Restoring (2 — running, with progress + Cancel), then Restored (done) whose 'Revert to raw take' is just the plain undo peeling one layer — the raw take is kept one undo away, in-session only (owner decision: no session-bundle format change). Colour carries the state: neutral = waiting, accent = active work, green = done. The trigger policy (fire at loop close / overdub finalize) lives in Dart; the engine stays policy-free.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"text","id":"DSV05","x":120,"y":8745,"name":"H/SIGNAL","fill":"#ffffff","content":"SIGNAL","fontFamily":"Inter","fontSize":52,"fontWeight":"600"},{"type":"text","id":"gABzz","x":120,"y":8832,"name":"S/SIGNAL","fill":"#9ea3b0","content":"what feeds each stage, what is applied there, and how it is shaped","fontFamily":"Inter","fontSize":22,"fontWeight":"normal"}]},{"type":"frame","id":"tPvC3","x":6700,"y":9363,"name":"03  Control","width":6320,"height":7379,"fill":"#1a1d24","cornerRadius":24,"stroke":"#48505f","strokeWidth":2,"layout":"none","children":[{"type":"text","id":"jS6iD","x":120,"y":62,"name":"03  Control /