:1.2,"fontFamily":"$font-ui","fontSize":"$text-xl","fontWeight":"700"}]},{"type":"frame","id":"bTHKj","name":"Right","width":"fill_container","layout":"vertical","gap":"$space-4","children":[{"type":"text","id":"HGvzH","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Tile grid is the overview; tapping a tile opens the full-width row as an editor sheet. A and B are the same design at two zoom levels, not two designs.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"S49PAM","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"C and D both lose on the one axis that made us drop the knob. A 44px fader or a 76px bar is no more precise than a 36px rotary — swapping an imprecise round control for an imprecise flat one fixes the grip problem and keeps the accuracy problem.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"uXCEB","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"The extra tap is affordable here specifically. This is a looper with a foot pedal: live, mid-take control belongs to the pedal, so the screen's job is setup and overview rather than performance. That is what makes A's cost cheap and C/D's precision loss expensive.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"H63wn","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"It reuses a pattern the console already has — tempo is edited exactly this way today, via a value that opens a keypad sheet.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]}]}]}]},{"type":"frame","id":"NUjCy","x":120,"y":7672,"name":"07 / 06 FX parameter — spec","width":1920,"height":2413,"layout":"none","children":[{"type":"text","id":"r94RFc","x":0,"y":10,"name":"Screen label / 06 FX parameter — spec","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"07  06 FX parameter — spec","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"R29c7","x":0,"y":72,"name":"DS / 06 FX parameter — spec","clip":true,"width":1920,"fill":"$bg-base","cornerRadius":"$radius-17","stroke":"$border-default","strokeWidth":1,"layout":"vertical","gap":48,"padding":64,"children":[{"type":"frame","id":"CGP8f","name":"Header","width":"fill_container","layout":"vertical","gap":"$space-4","children":[{"type":"text","id":"WiGmC","name":"Eyebrow","fill":"$accent","content":"SEGNO CONSOLE · RESOLVED","fontFamily":"$font-mono","fontSize":"$text-caption","fontWeight":"normal","letterSpacing":1.6},{"type":"text","id":"CKaaL","name":"Title","fill":"$text-primary","content":"FX parameters","fontFamily":"$font-ui","fontSize":52,"fontWeight":"700","letterSpacing":-1},{"type":"text","id":"x0u1mm","name":"Lede","fill":"$text-secondary","textGrowth":"fixed-width","width":1240,"content":"Option A + B, built. The tile grid is the overview; tapping a tile opens the full-width editor sheet. One design at two zoom levels. No rotary controls anywhere — Knob and FxParamKnobCell have been removed from the masters.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-base","fontWeight":"normal"}]},{"type":"frame","id":"Erban","name":"Tile states","width":"fill_container","layout":"vertical","gap":"$space-7","children":[{"type":"frame","id":"wFDjV","name":"Head","width":"fill_container","layout":"vertical","gap":"$space-2","children":[{"id":"dMPiw","type":"ref","ref":"Oh5cq","name":"Caption","content":"TILE STATES"},{"type":"text","id":"o1l8o5","name":"Desc","fill":"$text-muted","textGrowth":"fixed-width","width":1240,"content":"Every parameter kind shares one 59px skeleton: name, a 36px control, a 3px indicator. Nothing states in words what the control already shows — a switch's position is its value, and the indicator carries an enum's step. The indicator is a readout, not a handle.","lineHeight":1.45,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]},{"type":"frame","id":"Gfvtf","name":"States","width":"fill_container","gap":"$space-8","children":[{"type":"frame","id":"nuFta","name":"rest","width":78,"layout":"vertical","gap":"$space-4","alignItems":"center","children":[{"type":"frame","id":"gFUPm","name":"Slot","height":80,"alignItems":"center","children":[{"id":"q7j4H","type":"ref","ref":"dGBN6","name":"rest"}]},{"type":"text","id":"cgxXW","name":"L","fill":"$text-muted","textGrowth":"fixed-width","width":"fill_container","content":"rest","textAlign":"center","fontFamily":"$font-mono","fontSize":"$text-3xs","fontWeight":"normal"}]},{"type":"frame","id":"LuUgx","name":"editing","width":78,"layout":"vertical","gap":"$space-4","alignItems":"center","children":[{"type":"frame","id":"ACOhU","name":"Slot","height":80,"alignItems":"center","children":[{"id":"F22fP","type":"ref","ref":"dGBN6","name":"editing","descendants":{"A5cwm":{"fill":"$accent-surface","stroke":"$accent"}}}]},{"type":"text","id":"b1E3xb","name":"L","fill":"$text-muted","textGrowth":"fixed-width","width":"fill_container","content":"editing","textAlign":"center","fontFamily":"$font-mono","fontSize":"$text-3xs","fontWeight":"normal"}]},{"type":"frame","id":"Rbc8T","name":"at minimum","width":78,"layout":"vertical","gap":"$space-4","alignItems":"center","children":[{"type":"frame","id":"v4A3P","name":"Slot","height":80,"alignItems":"center","children":[{"id":"cdpXB","type":"ref","ref":"dGBN6","name":"at minimum","descendants":{"hTbP7":{"content":"-inf"},"LspiA":{"width":2}}}]},{"type":"text","id":"M7drAr","name":"L","fill":"$text-muted","textGrowth":"fixed-width","width":"fill_container","content":"at minimum","textAlign":"center","fontFamily":"$font-mono","fontSize":"$text-3xs","fontWeight":"normal"}]},{"type":"frame","id":"bNoUK","name":"at maximum","width":78,"layout":"verti