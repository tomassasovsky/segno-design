":119,"id":"XNr4u","name":"span","context":"span","fill":"#3a3a40","width":62,"height":5}]}]},{"type":"frame","id":"lpx38","layoutPosition":"absolute","x":1,"y":1,"name":"scrim","width":1918,"height":1078,"fill":"#08080a6b","layout":"none","children":[{"type":"frame","id":"oevtU","x":695,"y":435,"name":"dialog","width":528,"fill":"#161618","cornerRadius":17,"stroke":"#3a3a40","strokeWidth":1,"strokeAlignment":"inner","effect":{"type":"shadow","shadowType":"outer","color":"#00000099","offset":{"x":0,"y":29},"blur":72},"layout":"vertical","padding":25,"children":[{"type":"text","id":"v7wJa","name":"title","fill":"#f3f4f7","content":"Switch off the last output?","lineHeight":1.16,"fontFamily":"Inter","fontSize":19,"fontWeight":"650"},{"type":"frame","id":"L9v3mr","name":"spacer","width":"fill_container","height":10,"layout":"none"},{"type":"text","id":"uRmc4","name":"body","fill":"#9a9aa2","textGrowth":"fixed-width","width":"fill_container","content":"Out 2 is the only output still on. Off, the sum reaches nothing and the console is silent — the Audio face will warn until one is switched back on.","lineHeight":1.55,"fontFamily":"Inter","fontSize":16,"fontWeight":"normal"},{"type":"frame","id":"Q2arrH","name":"spacer","width":"fill_container","height":19,"layout":"none"},{"type":"frame","id":"rGNEA","name":"actions","width":"fill_container","gap":10,"justifyContent":"end","children":[{"type":"frame","id":"tasrJ","name":"Keep it on","height":40,"fill":"#1e1e21","cornerRadius":10,"stroke":"#3a3a40","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","padding":[10,14],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"flxCs","fill":"#f3f4f7","content":"Keep it on","lineHeight":1.2,"textAlign":"center","fontFamily":"Inter","fontSize":15,"fontWeight":"normal"}]},{"type":"frame","id":"ODP0j","name":"Switch off","height":40,"fill":"#e0a94a","cornerRadius":10,"stroke":"#e0a94a","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","padding":[10,14],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"E6JdK","fill":"#0b0b0c","content":"Switch off","lineHeight":1.2,"textAlign":"center","fontFamily":"Inter","fontSize":15,"fontWeight":"600"}]}]}]}]}]},{"type":"text","id":"Cd6s8","x":0,"y":1176,"name":"c/master-last-output","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Out 1 is already off; the tap on Out 2 stops here instead of landing. Switching the last live output off is the silence the Audio face warns about, and this must not be a way to reach it without being told — so the last one asks, in the warning’s own amber, not the destructive red: nothing is destroyed, and Keep it on costs nothing. The switch itself has not moved yet — the dialog intercepts the write, it does not undo it. Any other output’s switch flips silently, because every other off is reversible by ear.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"VHZ5B","x":4280,"y":5960,"name":"15 / fx param sheet","width":1920,"height":1289,"layout":"none","children":[{"type":"text","id":"wUdhe","x":0,"y":10,"name":"Screen label / fx param sheet","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"15  fx param sheet","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"M3PQQ","x":0,"y":72,"name":"SIGNAL / fx-param-sheet","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"GpIbq","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"r5hbq","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"dQGX5","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"dvAKU"