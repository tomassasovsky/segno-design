:"600"},{"type":"text","id":"TQVrs","x":0,"y":1257,"name":"c/audio","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Device, sample rate and buffer, named inputs, and the round-trip measurement. FOUR rows, not three: the Status tab was dissolved into this one, because everything it reported was either duplicated from here or belonged beside the setting that decides it. The measurement keeps an explicit MEASURE button — merging the readout and the action into a bare tappable row left nothing on screen saying the row did anything. Record offset rides as the latency row's subtitle: it is a consequence of the measurement, not a setting. No round-trip ESTIMATE — two buffer periods cannot include converter latency, so it read as authoritative and was not (#528).","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"R89dsj","x":2200,"y":260,"name":"02 / settings device","width":1920,"height":1273,"layout":"none","children":[{"type":"text","id":"rGeFH","x":0,"y":10,"name":"Screen label / settings device","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"02  settings device","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"V39Pf","x":0,"y":72,"name":"AUDIO / settings-device","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"CYkkB","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"T9kOn","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"b9GRL","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"VyTzY","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"Fq42d","name":"Bridge ide