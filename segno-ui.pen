,"fontFamily":"$font-mono","fontSize":"$text-2xs","fontWeight":"600","letterSpacing":1.2},{"id":"i68As","type":"ref","ref":"mHM0y","name":"Power","descendants":{"ORwPw":{"fill":"$fx"}}}]},{"type":"text","id":"DvpOl","name":"Chain","fill":"$fx","textGrowth":"fixed-width","width":"fill_container","content":"INPUT · GATE","lineHeight":1.15,"textAlign":"center","fontFamily":"$font-ui","fontSize":20,"fontWeight":"700","letterSpacing":0.5},{"type":"frame","id":"xvuS4","name":"ToggleRow","gap":10,"alignItems":"center","children":[{"type":"frame","id":"GOhBB","name":"Switch","width":52,"height":30,"fill":"$fx","cornerRadius":"$radius-pill","stroke":"#00000000","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"rectangle","cornerRadius":"$radius-pill","id":"LRnWZ","x":25,"y":3,"name":"Knob","fill":"#ffffff","width":24,"height":24}]},{"type":"text","id":"UqlL5","name":"State","fill":"$fx","content":"ON","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"700","letterSpacing":1.4}]}]},{"type":"frame","id":"PfD66","x":1526,"y":452,"name":"FX Toggle 4 (unbound)","width":300,"fill":"$bg-surface","cornerRadius":"$radius-12","stroke":"$border-subtle","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","gap":10,"padding":[16,18,18,18],"alignItems":"center","children":[{"type":"frame","id":"AGS6H","name":"Head","width":"fill_container","justifyContent":"space_between","alignItems":"center","children":[{"type":"text","id":"pl5eD","name":"Pedal","fill":"$text-muted","content":"PEDAL 4","fontFamily":"$font-mono","fontSize":"$text-2xs","fontWeight":"600","letterSpacing":1.2},{"id":"p7jKd","type":"ref","ref":"mHM0y","name":"Power","descendants":{"ORwPw":{"fill":"$border-strong"}}}]},{"type":"text","id":"W8kIs1","name":"Label","fill":"$text-tertiary","textGrowth":"fixed-width","width":"fill_container","content":"unbound","textAlign":"center","fontFamily":"$font-ui","fontSize":18,"fontWeight":"600","letterSpacing":0.3},{"type":"text","id":"XFyVw","name":"Hint","fill":"$text-muted","textGrowth":"fixed-width","width":"fill_container","content":"assign a chain in Signal","textAlign":"center","fontFamily":"$font-ui","fontSize":"$text-xs","fontWeight":"normal"}]}]},{"type":"text","id":"u5LME","x":0,"y":1176,"name":"t/stage-fx-overlay","fill":"#ffffff","content":"Stage — FX mode (overlay concept)","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"X1VcQ","x":0,"y":1218,"name":"c/stage-fx-overlay","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"FX mode = a DIM SCRIM over the UNMODIFIED track view + floating per-pedal ON/OFF toggles. Owner pivot 2026-08-27: this SUPERSEDES the in-place transform in VOgon (STAGE / stage-fx), which was rejected for re-dressing the track columns into chain tiles. New model: FX mode must NOT modify the track view behind it — the 4 track columns render EXACTLY as in normal mode (this frame is a verbatim copy of Ob2Mu = STAGE / stage; nothing in the track run was touched). On entering FX mode a translucent dark scrim ($bg-scrim, here bumped to ~55% black #0505088c) lays over the whole stage so the untouched tracks stay recognizable but recede. On top of the scrim float 4 FX controls, one centered over each track column — pedal N sits above column N, preserving footswitch spatial continuity. Each floating control shows the BOUND CHAIN's identity chain-first with its REAL target (MASTER · REVERB, LANE 2 · DRIVE, INPUT · GATE) and an ON/OFF switch — these are ON/OFF ONLY, NOT selectable like tracks: no selection border, no track-style tile, so the performer never learns a false tile=track-FX model. Purple FX accent for ON ($fx #a06be0 on $fx-surface #1e1430), dim/neutral for OFF. A pedal with no bound chain shows a subtle 'unbound' empty state (not a big NO CHAIN tile). DS reuse: FxPowerToggle (mHM0y) power glyph, $fx / $fx-surface / $bg-scrim tokens, radius-12, font-mono labels, the MASTER · REVERB chain-first label idiom from VOgon. Judgment calls for owner to confirm: scrim opacity (~55% here, tunable 40–55%), card width 300 / vertical placement centered in the track area, switch vs pill for the ON/OFF affordance, and the 'unbound' treatment (solid dim card here). This is a design example for approval — no app code touched.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"e0qAO","x":4280,"y":6215,"name":"15 / fx opt A","width":1920,"height":1230,"layout":"none","children":[{"type":"text","id":"bYM0g","x":0,"y":10,"name":"Screen label / fx opt A","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"15  fx opt A","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"UMcEK","x":0,"y":72,"name":"STAGE / fx-opt-A","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"H09n2","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"Q1g3X","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"R0rIsF","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"iGtWM","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"rHsj0","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"vPwIl","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","padding":1,"justifyContent":"center","alignItems":"center","children":[{"type":"frame","id":"U7tdT","name":"svg","context":"svg","clip":true,"width":19,"height":19,"layout":"none","children":[{"type":"ellipse","id":"FIg