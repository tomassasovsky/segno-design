ter card’s panel has no level and no “in the mix” — the sum has neither a volume nor a mute in the rig.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"G7pLe","x":120,"y":1685,"name":"04 / signal detail","width":1920,"height":1321,"layout":"none","children":[{"type":"text","id":"AKA3i","x":0,"y":10,"name":"Screen label / signal detail","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"04  signal detail","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"e7CHF1","x":0,"y":72,"name":"SIGNAL / signal-detail","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"RWRtn","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"XMxGz","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"mbLeq","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"b0bCp","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"ytL2k","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"Hy93X","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","padding":1,"justifyContent":"center","alignItems":"center","children":[{"type":"frame","id":"OY17E","name":"svg","context":"svg","clip":true,"width":19,"height":19,"layout":"none","children":[{"type":"ellipse","id":"jCodS","x":8.708333333333332,"y":3.1666666666666665,"width":1.5833333333333333,"height":1.5833333333333333,"stroke":"#9A9AA2","strokeWidth":1.5833333333333333,"strokeLin