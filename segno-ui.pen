0","letterSpacing":0.26}]},{"type":"frame","id":"pr9G9","name":"div","context":"div","clip":true,"width":"fill_container","height":994,"fill":"#000000","cornerRadius":17,"stroke":"#17171b","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","padding":13,"justifyContent":"end","children":[{"type":"text","id":"T3leUm","layoutPosition":"absolute","x":1,"y":8,"name":"4","context":"div","fill":"#8a8a92","textGrowth":"fixed-width","width":465,"content":"4","lineHeight":1,"textAlign":"center","fontFamily":"Inter","fontSize":24,"fontWeight":"700"},{"type":"text","id":"v2yat","name":"LEAD","context":"div","fill":"#ffffff","textGrowth":"fixed-width","width":"fill_container","content":"LEAD","lineHeight":1,"textAlign":"center","fontFamily":"Inter","fontSize":26,"fontWeight":"800","letterSpacing":0.26}]}]},{"id":"RRuZI","type":"ref","ref":"v8WR8k","name":"Device lost banner","layoutPosition":"absolute","x":10,"y":74,"width":1898,"descendants":{"DZO9h":{"content":"No audio device — nothing is heard","textGrowth":"auto","width":"fill_container"},"xQn7V/P8fizX":{"content":"Open setup"}}}]},{"type":"rectangle","cornerRadius":[0,0,17,17],"id":"pkcak","x":1,"y":-1078,"name":"div","context":"div","fill":"#161618","width":1918,"height":1078,"stroke":"#3a3a40","strokeWidth":{"bottom":1},"strokeAlignment":"inner","effect":{"type":"shadow","shadowType":"outer","color":"#00000099","offset":{"x":0,"y":19},"blur":48}},{"type":"rectangle","cornerRadius":119,"id":"kJzZG","x":926.5,"y":11,"name":"button","context":"button","fill":"#ffffff21","width":67,"height":6}]},{"type":"text","id":"DK4HE","x":0,"y":1176,"name":"c/device-lost","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Notification surface chosen by stakes — transient toast for low-stakes (MIDI lost: loops keep playing), persistent non-dismissable banner for immediate-action (audio device lost: nothing is heard); never two bars for one cause — the audio banner absorbs the engine-stopped message. (Owner decision, 2026-08-26.) This supersedes the earlier three-bar in-flow stack and the two-banner device+MIDI spike: the audio-device-lost banner now stands alone in the record red with tight copy and an inline action (Open setup), standing in place of the engine-stopped bar rather than stacking with it; the MIDI-lost case moves to a bottom toast in warning amber (see STAGE / midi-lost-toast), no action, self-dismissing when the controller returns. Neither ever appears as a dialog: a lost interface mid-song must not also steal the transport. The 7-inch readout echoes the audio line in its status strip — the performer is looking down, not at this screen.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"gkBF5","x":120,"y":4791,"name":"10 / readout volumes","width":1920,"height":1304,"layout":"none","children":[{"type":"text","id":"BZgkP","x":0,"y":10,"name":"Screen label / readout volumes","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"10  readout volumes","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"S1YHE3","x":0,"y":72,"name":"STAGE / readout-volumes","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","layout":"none","children":[{"type":"frame","id":"k939Kp","x":1,"y":1,"name":"volumes","clip":true,"width":1918,"height":1078,"fill":"$bg-stage","layout":"vertical","gap":14,"padding":32,"children":[{"type":"frame","id":"RB6IW","name":"Inputs caption + dismiss","width":"fill_container","justifyContent":"space_between","alignItems":"end","children":[{"type":"text","id":"zi3ui","name":"Inputs caption","fill":"$text-muted","content":"INPUTS","lineHeight":1,"fontFamily":"$font-ui","fontSize":36,"fontWeight":"normal","letterSpacing":2.52},{"type":"frame","id":"XKeme","name":"Back to stage chip","cornerRadius":"$radius-pill","stroke":"$border-strong","strokeWidth":2,"strokeAlignment":"inner","padding":[14,32],"children":[{"type":"text","id":"S4D7R6","name":"Chip label","fill":"$text-secondar