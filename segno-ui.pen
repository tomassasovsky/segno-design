#ffffff12","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"rectangle","id":"NvDmb","x":1,"y":1,"name":"Slider fill","fill":"$accent-surface","width":580,"height":108,"stroke":"$accent","strokeWidth":{"right":4},"strokeAlignment":"inner"}]},{"type":"text","id":"hABz5","name":"Value","fill":"$text-secondary","textGrowth":"fixed-width","width":220,"content":"0.0 dB","textAlign":"right","fontFamily":"$font-ui","fontSize":40,"fontWeight":"normal"},{"type":"frame","id":"GvyID","name":"Config zone","width":88,"height":"fill_container","layout":"vertical","justifyContent":"center","alignItems":"center","children":[{"type":"icon","id":"OOXMa","name":"Chevron","width":44,"height":44,"icon":"chevron-right","library":"lucide","fill":"$text-muted"}]}]}]},{"type":"rectangle","cornerRadius":3,"id":"m0wGiV","layoutPosition":"absolute","x":1902,"y":128,"name":"Scrollbar hint","fill":"#ffffff2e","width":6,"height":700}]}]},{"type":"text","id":"mclaU","x":0,"y":1176,"name":"c/readout-volumes","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Tapping ANYWHERE on the 7″ readout opens this volume overlay (#698) — the whole glass is the touch target; there is no dedicated button. It is drawn as a full-screen panel on $bg-stage, not a modal over dimmed content: at 7″ a modal frame wastes pixels, and the panel keeps the 2 m type discipline. The overlay is a SINGLE full-width SCROLLING list (ListView): the header (INPUTS caption + BACK TO STAGE chip) is PINNED at the top and the list scrolls under it; rows stay full-width (1854) at 110 high so sliders remain touch-controllable — no column compression. The drawing shows the honest viewport: the rows that fit, the next row (TRACK 6) cut by the bottom edge, and a slim scrollbar hint on the right — TRACK 7–8 exist below the fold. Dismissal: tap the BACK TO STAGE chip, tap any dead space, or 8 s of inactivity auto-reverts to the readout. Both groups are DYNAMIC: INPUTS shows one row per configured input (two drawn), TRACKS shows the LIVE TRACK COUNT — the engine runs 8; only 4 carry custom names, and default-named tracks (TRACK 5–8, l10n defaultTrackName) render their name in $text-secondary, the tone the tracks screen uses for a track's default identity, while custom names are $text-primary. Each row is the ParamSlider idiom (ThalA) scaled to finger + 2 m size: name 42/700 in a 300 column, $bg-surface capsule track with $accent-surface fill and 4 px $accent right-edge marker, value 40 Inter (signed dB, one decimal, true minus — signal_style.dart format; tabular numerals at implementation), and a CONFIG ZONE at the row's right edge: an 88×110 chevron target. Interaction contract: tap/drag anywhere on the row = volume; tap the chevron zone = that element's own full-screen config panel (STAGE / readout-volumes-input, STAGE / readout-volumes-track); the panel's BACK chip returns to this list; the 8 s auto-revert chain applies from the panels too (panel → list → readout). Wire protocol: volume and config commands flow sub→main over the window channel — the first control path in that direction (the readout was previously display-only).","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"IYLbU","x":2200,"y":4791,"name":"11 / readout volumes input","width":1920,"height":1224,"layout":"none","children":[{"type":"text","id":"Z3GSj","x":0,"y":10,"name":"Screen label / readout volumes input","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"11  readout volumes input","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"HqSgj","x":0,"y":72,"name":"STAGE / readout-volumes-input","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","layout":"none","children":[{"type":"frame","id":"YdY3z","x":1,"y":1,"name":"input-config","width":1918,"height":1078,"fill":"$bg-stage","layout":"vertical","gap":28,"padding":32,"children":[{"type":"frame","id":"NY6BV","name":"Header","width":"fill_container","justifyCo