:"#202329","cornerRadius":8,"stroke":"#5a6577","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"text","id":"WvkTz","x":26.494999999999997,"y":24.5,"name":"10 min","metadata":{"type":"prototype-text","rect":{"x":26.97,"y":22.5,"width":78.05,"height":30},"align":"center"},"fill":"#dbe1ed","content":"10 min","lineHeight":1,"fontFamily":"Arimo","fontSize":26,"fontWeight":"normal"}]}]}]}]}]}]}]},{"type":"frame","id":"UgEXg","x":120,"y":2804,"name":"Track display calibration face / Tile","width":1024,"height":672,"layout":"none","children":[{"type":"text","id":"zyqxd","x":0,"y":0,"name":"Track display calibration face / Title","fill":"#e2e7f0","content":"Track display calibration · on the 7\"","fontFamily":"Arimo","fontSize":38,"fontWeight":"normal"},{"type":"frame","id":"RqPKr","x":0,"y":72,"name":"DISPLAYS UX / Track display calibration face","clip":true,"width":1024,"height":600,"fill":"#0b0b0c","layout":"none","children":[{"type":"frame","id":"kOACq","x":86.88,"y":60,"name":"touch-target","context":"div","metadata":{"type":"prototype-element","tag":"div","rect":{"x":107.06,"y":70.27,"width":72,"height":72},"textAlign":"start"},"width":72,"height":72,"cornerRadius":50,"stroke":"#d8e8fa","strokeWidth":2,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"bz3dz","x":35,"y":-19,"name":"span","context":"span","metadata":{"type":"prototype-element","tag":"span","rect":{"x":35,"y":-19,"width":2,"height":110},"textAlign":"start"},"width":2,"height":110,"fill":"#afc8e8","layout":"none"},{"type":"frame","id":"bS8fZ","x":-19,"y":35,"name":"b","context":"b","metadata":{"type":"prototype-element","tag":"b","rect":{"x":-19,"y":35,"width":110,"height":2},"textAlign":"start"},"width":110,"height":2,"fill":"#afc8e8","layout":"none"}]},{"type":"text","id":"M3dkPs","x":940,"y":16,"name":"readout-calibration-label","fill":"#9a9aa2","content":"1 of 5","fontFamily":"Arimo","fontSize":15,"fontWeight":"normal"}]}]},{"type":"text","id":"kvL8U","x":2200,"y":2804,"name":"c/ Implementation · Touch calibration","fill":"#a3adbd","textGrowth":"fixed-width","width":3880,"content":"c/ Native implementation · Touch calibration (#1330, branch claude/ivi-only-1330-p3)\nThe Track display is calibrated on the Track display: its targets are drawn on the 7\" itself through the screen link (left), because only a tap on that panel can measure it. The main display page keeps the instruction (\"Tap the center of each target on the Track display\"), the step, the countdown and the buttons, and mirrors where the target is in the 1186 x 660 area; a tap on the mirror is not counted.\nCapture targets: 12% / 16% in from each corner, then the centre. Test targets: (0.28, 0.30), (0.72, 0.70), (0.45, 0.78) of the screen. A test tap counts within 4% of its target; once all three are hit the heading reads \"Touch works\".\nThe matrix is in whole-screen terms, so the main area's targets and taps are converted to the 1920 x 1080 screen before the fit, and the fit is composed with the calibration already in force.\nNot kept within 30 s, Cancel, Back or leaving the page puts the previous calibration back. Colours: the area uses the meter-track ground and the frame control line; Keep calibration uses the accent action tone.","fontFamily":"Arimo","fontSize":28,"fontWeight":"normal"}]},{"type":"frame","id":"PQ2W9","x":180,"y":61596,"name":"31  Storage & safe eject","context":"Owner accepted 2026-09-07: storage overview, capacity, shared Library navigation, busy transfer protection and safe USB eject. Hardware remains simulated.","width":6320,"height":2804,"fill":"#171c25","cornerRadius":24,"stroke":"#353f51","strokeWidth":2,"layout":"none","children":[{"type":"text","id":"eJx4w","x":120,"y":62,"name":"Storage / Title","fill":"#f4f5f7","content":"31  Storage & safe eject","fontFamily":"Arimo","fontSize":68,"fontWeight":"700"},{"type":"text","id":"KTetA","x":120,"y":160,"name":"Storage / Status","fill":"#a4adbd","content":"Accepted · capa