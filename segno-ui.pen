div","fill":"#9a9aa2","content":"tap to load one","lineHeight":1.35,"fontFamily":"Inter","fontSize":14,"fontWeight":"normal"},{"type":"text","id":"a2GMjX","name":"MONITOR: OFF","context":"div","fill":"#6b6b73","content":"MONITOR: OFF","lineHeight":1.23,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal","letterSpacing":0.78},{"type":"text","id":"HTNgx","name":"cond","fill":"#6b6b73","content":"COND · OFF","lineHeight":1.23,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal","letterSpacing":0.78}]}]}]},{"type":"frame","id":"gQymR","layoutPosition":"absolute","x":0,"y":1046,"name":"button","context":"button","width":"fill_container(1918)","height":31,"padding":[1,6],"justifyContent":"center","alignItems":"center","children":[{"type":"rectangle","cornerRadius":119,"id":"W2VQC","name":"span","context":"span","fill":"#3a3a40","width":62,"height":5}]}]}]},{"type":"text","id":"irFaP","x":0,"y":1176,"name":"c/input-clip","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Input-card faces carrying the two live conditioning signals. #697 slice S5, frame 2 of 3. CLIP is the input overload badge (from le_snapshot.input_clip_mask): a filled record-red alarm — a rail run of >=4 samples at >=0.999 held ~1.5 s. It reads the RAW ADC, upstream of the HPF/notch, which is why it can light on the guitar card even though that input is being conditioned: the converter clips before any biquad can act, so conditioning must never suppress it. The input's own peak meter turns its top/peak segment record-red at the same moment, so the meter itself signals clip — not just the badge. Filled red (not the outline of MODIFIED) marks it as an alarm, not a status. Owner decision 2026-08-27: clip is INPUT-ONLY — a property of the physical jack (raw ADC), never the track; the track-face clip treatment (the former 'STAGE / track-hot' frame) is dropped, and the user-facing word is CLIP, not HOT. Engine state is unchanged: a_input_clip_mask / LE_CLIP_* internally; only the label reads CLIP. The COND line (from input_cond_mask) names the active sections — HPF · HUM · EXP — in accent when on, muted 'COND · OFF' when the stage is bypassed; it sits below the existing MONITOR line because both are facts about the jack. CLIP (red) / MODIFIED (amber outline, chain drift) / COND (accent) stay three distinct colours so a glance separates 'the input is overloading' from 'the chain drifted from its rack' from 'the input is being cleaned up'.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"mt5vx","x":4280,"y":7369,"name":"18 / restore states","width":1920,"height":1240,"layout":"none","children":[{"type":"text","id":"Noc55","x":0,"y":10,"name":"Screen label / restore states","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"18  restore states","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"gSOpF","x":0,"y":72,"name":"SIGNAL / restore-states","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"Q2JtA","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"LQvFX","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"Yjt6z","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"Jk0rv","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"anHei","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"EhzPD","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","padding":1,"justifyCont