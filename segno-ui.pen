ame":"note","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Promoted to chain chrome; never duplicated as a tile.","lineHeight":1.35,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]},{"type":"frame","id":"RWtn1","name":"isReadOnly","width":"fill_container","height":62,"stroke":"$border-hairline","strokeWidth":{"bottom":1},"strokeAlignment":"inner","gap":"$space-7","padding":[0,20],"alignItems":"center","children":[{"type":"text","id":"C45OMT","name":"cond","fill":"$text-primary","textGrowth":"fixed-width","width":420,"content":"isReadOnly","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"xCSxS","name":"ctrl","fill":"$accent","textGrowth":"fixed-width","width":340,"content":"FxParamTile · read-only","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"Uxkuc","name":"note","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Borderless, indicator only, not tappable. Meters land here.","lineHeight":1.35,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]},{"type":"frame","id":"bL8Zp","name":"stepCount == 1","width":"fill_container","height":62,"stroke":"$border-hairline","strokeWidth":{"bottom":1},"strokeAlignment":"inner","gap":"$space-7","padding":[0,20],"alignItems":"center","children":[{"type":"text","id":"wG3P5","name":"cond","fill":"$text-primary","textGrowth":"fixed-width","width":420,"content":"stepCount == 1, unnamed","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"d3lbeG","name":"ctrl","fill":"$accent","textGrowth":"fixed-width","width":340,"content":"FxParamSwitchCell","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"FFs0d","name":"note","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Its position IS the value. 36px leaves room for no caption.","lineHeight":1.35,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]},{"type":"frame","id":"Z12c90","name":"2 <= stepCount <= 24","width":"fill_container","height":62,"stroke":"$border-hairline","strokeWidth":{"bottom":1},"strokeAlignment":"inner","gap":"$space-7","padding":[0,20],"alignItems":"center","children":[{"type":"text","id":"ZyR3O","name":"cond","fill":"$text-primary","textGrowth":"fixed-width","width":420,"content":"named steps, 2..24","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"V4Oo07","name":"ctrl","fill":"$accent","textGrowth":"fixed-width","width":340,"content":"FxParamEnumCell","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"fRtcu","name":"note","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"A name for every step, from paramValueText. TWO named states come here, not to the switch — a switch cannot show a name.","lineHeight":1.35,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]},{"type":"frame","id":"h0mlgB","name":"stepCount > 24","width":"fill_container","height":62,"stroke":"$border-hairline","strokeWidth":{"bottom":1},"strokeAlignment":"inner","gap":"$space-7","padding":[0,20],"alignItems":"center","children":[{"type":"text","id":"iPgTq","name":"cond","fill":"$text-primary","textGrowth":"fixed-width","width":420,"content":"stepCount > 24","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"jfJmP","name":"ctrl","fill":"$accent","textGrowth":"fixed-width","width":340,"content":"FxParamTile · snapped","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"Inyv4","name":"note","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Too many for a menu. Sheet bar snaps to steps.","lineHeight":1.35,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]},{"type":"frame","id":"QCZvc","name":"stepCount == 0","width":"fill_container","height":62,"stroke":"$border-hairline","strokeWidth":{"bottom":1},"strokeAlignment":"inner","gap":"$space-7","padding":[0,20],"alignItems":"center","children":[{"type":"text","id":"n3izHd","name":"cond","fill":"$text-primary","textGrowth":"fixed-width","width":420,"content":"stepCount == 0","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"uZdLZ","name":"ctrl","fill":"$accent","textGrowth":"fixed-width","width":340,"content":"FxParamTile · continuous","fontFamily":"$font-mono","fontSize":"$text-sm","fontWeight":"normal"},{"type":"text","id":"vSVbG","name":"note","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"The default. Sheet opens in bar mode.","lineHeight":1.35,"fontFamily":"$font-ui","fontSize":"$text-sm","fontWeight":"normal"}]}]}]},{"type":"frame","id":"Ew3e0","name":"Density rules","width":"fill_container","layout":"vertical","gap":"$space-7","children":[{"id":"Y73Bq","type":"ref","ref":"Oh5cq","name":"Caption","content":"DENSITY & OVERFLOW"},{"type":"frame","id":"BetkY","name":"Cards","width":"fill_container","gap":"$space-7","children":[{"type":"frame","id":"M97TMl","name":"20 per row, then wrap","width":"fill_container","fill":"$bg-elevated","cornerRadius":"$radius-10","stroke":"$border-default","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","gap":"$space-4","padding":"$space-8","children":[{"type":"text","id":"nADTt","name":"T","fill":"$text-primary","textGrowth":"fixed-width","width":"fill_container","content":"20 per row, then wrap","lineHeight":1.25,"fontFamily":"$font-ui","fontSize":"$text-md","fontWeight":"600"},{"type":"text","id":"UMgtk","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"78px tile on a 7px gutter fills a 1738px panel at 20 columns. The grid wraps and scrolls vertically; it never scrolls horizontally, so no parameter can hide off the right edge.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-xs","fontWeight":"normal"}]},{"type":"frame","id":"bF0Rl","name":"Names truncate, the sheet does not","width":"fill_container","fill":"$bg-elevated","cornerRadius":"$radius-10","stroke":"$border-default","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","gap":"$space-4","padding":"$space-8","children":[{"type":"text","id":"M0Qgxx","name":"T","fill":"$text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Names truncate, the sheet does not","lineHeight":1.25,"fontFamily":"$font-ui","fontSize":"$text-md","fontWeight":"600"},{"type":"text","id":"qYm63","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"A tile name is mono 9px in 78px — about 10 characters. Longer names ellipsize on the tile and appear in full in the sheet header, which is where you are when you actually need to read it.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-xs","fontWeight":"normal"}]},{"type":"frame","id":"mDcG7","name":"Plugin text wins in the sheet, numbers win on the tile","width":"fill_container","fill":"$bg-elevated","cornerRadius":"$radius-10","stroke":"$border-default","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","gap":"$space-4","padding":"$space-8","children":[{"type":"text","id":"WTo6u","name":"T","fill":"$text-primary","textGrowth":"fixed-width","width":"fill_container","content":"One string, straight from the plugin","lineHeight":1.25,"fontFamily":"$font-ui","fontSize":"$text-md","fontWeight":"600"},{"type":"text","id":"w5p4Fz","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"The value and its unit live together in the box, because paramValueText hands them over as a single string — \"-6.0 dB\", \"Lowpass\", \"1/4 dotted\". Splitting them would mean parsing the plugin's own formatting apart. When a plugin offers no text, the tile falls back to the numeric value plus the separate unit field; when it does, the unit slot simply goes unused, as on KNEE = \"soft\".","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-xs","fontWeight":"normal"}]},{"type":"frame","id":"RrJ5Q","name":"The grid is never the live surface","width":"fill_container","fill":"$bg-elevated","cornerRadius":"$radius-10","stroke":"$border-default","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","gap":"$space-4","padding":"$space-8","children":[{"type":"text","id":"AL6ec","name":"T","fill":"$text-primary","textGrowth":"fixed-width","width":"fill_container","content":"The grid is never the live surface","lineHeight":1.25,"fontFamily":"$font-ui","fontSize":"$text-md","fontWeight":"600"},{"type":"text","id":"VDpTk","name":"B","fill":"$text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Tiles commit nothing on touch — they open the sheet. Mid-take control belongs to the foot pedal, so no drag on this screen can change audio by accident.","lineHeight":1.5,"fontFamily":"$font-ui","fontSize":"$text-xs","fontWeight":"normal"}]}]}]}]}]},{"type":"frame","id":"dhDYD","x":2200,"y":7672,"name":"08 / Hardware / Segno pedal face","width":1920,"height":414,"layout":"none","children":[{"type":"text","id":"OQUmW","x":0,"y":10,"name":"Screen label / Hardware / Segno pedal face","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"08  Hardware / Segno pedal face","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"Qdj7x","x":0,"y":72,"name":"Hardware / Segno pedal face","context":"Reusable vector reconstruction from Fusion: tapered metal body, rubber pad, thirty grips and manufacturing label outlines. Instances override label, selected colors and size.","reusable":true,"width":252,"height":342,"layout":"none","children":[{"type":"path","id":"LQI8q","x":0,"y":0,"name":"Left hinge","geometry":"M3.8 20.9h-1.1q-2.2 0.2-2.2 3.1v3q0 2.1 2.2 2.3h1.1z","viewBox":[0,0,84,