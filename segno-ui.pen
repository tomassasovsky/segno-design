y Verb","fill":"$bg-control","cornerRadius":8,"stroke":"$border-subtle","strokeWidth":1,"padding":[8,14],"children":[{"type":"text","id":"KPpYR","name":"Entry label","fill":"$text-primary","content":"Exp","fontFamily":"$font-ui","fontSize":18,"fontWeight":"600"}]}]},{"type":"frame","id":"y7I8t","name":"State OFF","fill":"$fx","cornerRadius":"$radius-pill","stroke":"$border-strong","padding":[16,46],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"A4eQ5M","name":"State label","fill":"$text-on-accent","content":"ON","fontFamily":"$font-ui","fontSize":40,"fontWeight":"800","letterSpacing":1.4}]}]}]},{"type":"frame","id":"w5HeA","name":"div","context":"div","clip":true,"width":"fill_container","height":994,"fill":"#000000","cornerRadius":17,"stroke":"#17171b","strokeWidth":1,"strokeAlignment":"inner","layout":"vertical","padding":13,"justifyContent":"end","children":[{"type":"text","id":"LeVJF","layoutPosition":"absolute","x":1,"y":8,"name":"4","context":"div","fill":"#8a8a92","textGrowth":"fixed-width","width":465,"content":"4","lineHeight":1,"textAlign":"center","fontFamily":"Inter","fontSize":24,"fontWeight":"700"},{"type":"frame","id":"ZjMey","layoutPosition":"absolute","x":0,"y":0,"name":"FX dressing","width":467,"height":994,"layout":"vertical","gap":22,"padding":[0,20,150,20],"justifyContent":"center","alignItems":"center","children":[{"type":"text","id":"X3Ufq","name":"No chain","fill":"$text-muted","content":"NO CHAIN","fontFamily":"$font-ui","fontSize":28,"fontWeight":"700","letterSpacing":1},{"type":"text","id":"PXM3C","name":"Hint","fill":"$text-muted","content":"build one in Signal","fontFamily":"$font-ui","fontSize":18,"fontWeight":"normal"}]}]}]}]},{"type":"rectangle","cornerRadius":[0,0,17,17],"id":"VN384","x":1,"y":-1078,"name":"div","context":"div","fill":"#161618","width":1918,"height":1078,"stroke":"#3a3a40","strokeWidth":{"bottom":1},"strokeAlignment":"inner","effect":{"type":"shadow","shadowType":"outer","color":"#00000099","offset":{"x":0,"y":19},"blur":48}},{"type":"rectangle","cornerRadius":119,"id":"gElih","x":926.5,"y":11,"name":"button","context":"button","fill":"#ffffff21","width":67,"height":6}]},{"type":"text","id":"fzja8","x":0,"y":1176,"name":"t/stage-fx","fill":"#ffffff","content":"Stage — FX mode","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"M56J22","x":0,"y":1218,"name":"g/stage-fx","fill":"#738cf2","content":"mode","fontFamily":"Inter","fontSize":12,"fontWeight":"600"},{"type":"text","id":"Jq4Fp","x":0,"y":1257,"name":"c/stage-fx","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"#692 direction (owner, 2026-08-26): candidate A — transform in place — wins. Tile geometry, 1–8 key parity and the footswitch map stay frozen; the stage takes the FX surface; each tile re-dresses with chain identity. Grafted from candidate B: the per-chain power pill (the dominant state element per tile) and the entry-run line (entries in signal order). A won on spatial stability and reading distance; B was rejected because it re-maps the performer's space mid-song and duplicates Signal's editing-scale detail one tab away. The entry-run line is where #601's dim/strikethrough idiom applies to bypassed entries (tile 3 shows the whole-chain-off dim). Meters stay truthful (pre-chain) at 40% alpha — more present than the spike's 20%. FX mode colour is PURPLE, no longer accent blue: $fx #a06be0 + $fx-surface #1e1430 (flat, per #737) + $fx-wash #a06be024. WCAG (4.5:1 floor, 14px w700): fx on fx-surface 4.74:1, fx on bg-base 5.32:1, fx on stage black 5.67:1, fx on wash-over-bg 4.60:1. High-contrast flavor (where #768/#770 slipped): fx-hc #c9a8ff on fx-surface-hc #33245a 6.83:1, on black 10.53:1. The Dart theme change — SurfaceTheme modePair FX arm → purple across all three flavors (default/neon share SurfaceTheme.dark, plus highContrast), and every FX accent use on this surface — is owed by the #692 build.\n\nCorrection (owner, 2026-08-26): the first cut of candidate A conflated the track with the FX control — it dressed track tile N with chain N's identity + power pill, falsely asserting the chain belongs to that column's track. A footswitch in FX mode toggles a BOUND CHAIN, and that chain may target ANY FX stage (input / track / lane / master) or a rack — not necessarily the track in that column. Fix: each cell is identified by the bound chain and its REAL target, written TARGET-then-chain (e.g. MASTER · REVERB, LANE 2 · DRIVE, INPUT · GATE, TRACK 3 · CRUSH). ALWAYS chain-first: even when a chain genuinely targets the column's own track, show it as \"TRACK n · <chain>\" and never borrow the track's name/number as the cell identity, so the performer never learns the false tile=track-FX model. The track name is gone from the cell; the footswitch number (1–4) stays as a small physical-switch position marker, so spatial continuity — candidate A's one good property — is preserved. Sample cells now mix stages (MASTER · REVERB [ON], LANE 2 · DRIVE [OFF], INPUT · GATE [ON], NO CHAIN) so it's obvious chains aren't track-bound. Unchanged: purple FX treatment ($fx #a06be0 / $fx-surface #1e1430 / $fx-wash #a06be024, HC $fx #c9a8ff on #33245a), the ON/OFF power pill, the entry-run signal-order chips, meters at 40% alpha, and the NO-CHAIN state.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"GQXYe","x":4280,"y":1653,"name":"06 / track rename","width":1920,"height":1273,"layout":"none","children":[{"type":"text","id":"X8fhD","x":0,"y":10,"name":"Screen label / track rename","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"06  track rename","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"aaQ4M","x":0,"y":72,"name":"STAGE / track-rename","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"f5HK5