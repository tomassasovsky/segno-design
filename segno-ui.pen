":1,"y":1,"name":"Fill","fill":"#16233d","width":420,"height":51,"stroke":"#3b82f6","strokeWidth":{"right":2},"strokeAlignment":"inner"}]},{"type":"text","id":"L9NCvH","name":"Value","fill":"#9a9aa2","textGrowth":"fixed-width","width":96,"content":"150 ms","textAlign":"right","fontFamily":"JetBrains Mono","fontSize":14,"fontWeight":"normal"}]}]},{"type":"text","id":"IAR3H","name":"footer","fill":"#6b6b73","textGrowth":"fixed-width","width":"fill_container","content":"Zero added latency — applied once per input, before both the take and the monitor split.","lineHeight":1.3,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]}]},{"type":"frame","id":"ABT24","layoutPosition":"absolute","x":0,"y":1046,"name":"button","context":"button","width":"fill_container(1918)","height":31,"padding":[1,6],"justifyContent":"center","alignItems":"center","children":[{"type":"rectangle","cornerRadius":119,"id":"MaWww","name":"span","context":"span","fill":"#3a3a40","width":62,"height":5}]}]}]},{"type":"text","id":"z0waUm","x":0,"y":1176,"name":"c/input-conditioning","fill":"#9ea3b0","textGrowth":"fixed-width","width":1800,"content":"Per-input conditioning detail, reached from the input sub-tab. #697 slice S5, frame 1 of 4. The stage is a fixed utility, not a chain entry — it cannot be reordered, never enters the chain fingerprint, and its params read in real units (Hz, dB, ratio, ms), which is why the controls are ParamSliders with unit read-outs and not the normalised 0..1 FX knobs. Three sections, each with its own On/Off because 0 = section off in the engine (HPF cutoff 0, hum base 0): high-pass, hum notch (mains base 50/60 + harmonic count, default 4), downward expander (threshold / ratio / release; attack fixed ~5 ms, no look-ahead). Enable and every param are per input, not per lane — siblings capture identical samples. PRINTED INTO THE TAKE reuses the record-red chip verbatim: conditioning sits upstream of capture, so the recorded PCM already embodies it, and the monitor hears exactly what records (WYSIWYG). Zero added latency is a hard design rule (IIR biquads + no-lookahead envelope follower), stated in the footer so the stage is never mistaken for a look-ahead processor.","fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"TAI1g","x":2200,"y":7369,"name":"17 / input clip","width":1920,"height":1256,"layout":"none","children":[{"type":"text","id":"Q6puH","x":0,"y":10,"name":"Screen label / input clip","fill":"#c9ced9","textGrowth":"fixed-width","width":1920,"content":"17  input clip","fontFamily":"Arimo","fontSize":32,"fontWeight":"700"},{"type":"frame","id":"onYgt","x":0,"y":72,"name":"SIGNAL / input-clip","context":"div","clip":true,"width":1920,"height":1080,"fill":"#0b0b0c","cornerRadius":17,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","layout":"none","children":[{"type":"frame","id":"rmmuY","x":1,"y":1,"name":"div","context":"div","width":1918,"layout":"vertical","gap":10,"padding":[24,10,10,10],"children":[{"type":"frame","id":"GQ0s0","name":"div","context":"div","width":"fill_container","gap":12,"padding":[0,2,2,2],"alignItems":"center","children":[{"type":"frame","id":"jMVyg","name":"div","context":"div","gap":10,"alignItems":"center","children":[{"type":"ellipse","id":"rFdKp","name":"span","context":"span","fill":"#e0a94a","width":6,"height":6},{"type":"text","id":"uTX8b","name":"Bridge idea 3","context":"div","fill":"#f3f4f7","content":"Bridge idea 3","lineHeight":1.13,"fontFamily":"Inter","fontSize":16,"fontWeight":"600"},{"type":"frame","id":"UR8FI","name":"button","context":"button","width":38,"height":38,"cornerRadius":10,"stroke":"#2a2a2e","strokeWidth":1,"strokeAlignment":"inner","padding":1,"justifyContent":"center","alignItems":"center","children":[{"type":"frame","id":"QrqMQ","name":"svg","context":"svg","clip":true,"width":19,"height":19,"layout":"none","children":[{"type":"ellipse","id":"i0R7n","x":8.708333333333332,"y":3.1666666666666665,"width":1.5833333333333333